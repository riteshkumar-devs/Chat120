rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles: Anyone can search profiles by name or ID, but only owner can modify
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.uid == userId;
      allow delete: if true;
    }

    // Chats: Direct messages and groups
    match /chats/{chatId} {
      allow read: if true;
      allow create: if request.resource.data.participants is list;
      allow update: if true;
      allow delete: if true;
    }

    // Messages: Realtime end-to-end encrypted messaging in chats
    match /chats/{chatId}/messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.chatId == chatId;
      allow update: if true;
      allow delete: if true;
    }

    // Calls: WebRTC signaling for peer-to-peer encrypted voice calls
    match /calls/{callId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
